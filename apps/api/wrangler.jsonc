{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bhasha-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-19",
  "vars": {
    "CLOUDFLARE_REALTIME_BASE_URL": "https://rtc.live.cloudflare.com/v1",
    "CLOUDFLARE_TURN_BASE_URL": "https://rtc.live.cloudflare.com/v1",
    // Relay engine master switch (default ON — the relay is now the ALWAYS-ON
    // listener-isolation path; there is no direct fallback). The listener-coord
    // divergence and the translator->relay wiring assume this is "true".
    // CI overrides this at deploy: deploy.yml exports RELAY_ENABLED from the GitHub
    // repo variable (canonicalized so only an explicit "false" disables it) and
    // passes `--var "RELAY_ENABLED:$RELAY_ENABLED"`. Local `wrangler dev` uses this
    // default. Relay benefits only the partytracks listener, so keep
    // VITE_USE_PARTYTRACKS=true alongside it.
    "RELAY_ENABLED": "true"
  },
  "routes": [
    {
      "pattern": "translate.example.com/api/*",
      "zone_name": "example.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bhasha-dev",
      "database_id": "replace-with-your-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "CONNECTION_EVENTS", "queue": "bhasha-connection-events" }
    ],
    "consumers": [
      {
        "queue": "bhasha-connection-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "bhasha-connection-events-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROGRAM_PRESENCE",
        "class_name": "ProgramPresence"
      },
      {
        "name": "RELAY",
        "class_name": "StreamRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProgramPresence"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["StreamRelay"]
    }
  ]
}
