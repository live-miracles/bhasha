# Environment for docker-compose.yml (app + livekit + caddy) AND for running
# apps/api's dev/start scripts directly (they load this same repo-root .env
# via Node's --env-file flag). Copy this file to `.env` and fill in real
# values -- `.env` is gitignored (see .gitignore's ".env"/".env.*" entries)
# and must NEVER be committed with real secrets.
# This replaces the old Cloudflare-era apps/api/.dev.vars.example (Wrangler
# secrets), which documented vars (CLOUDFLARE_REALTIME_APP_ID etc.) that no
# longer exist post-migration.
#
# Generate random secrets with, e.g.: openssl rand -hex 32

# ---- Admin auth ----
# Signs admin session cookies.
ADMIN_SESSION_SECRET=replace-with-random-admin-session-secret
# There is no admin credential env var -- the app seeds a single admin
# account (username "admin", password "admin") on first startup if none
# exists yet (see UsersRepository.ensureDefaultAdmin). Log in and change the
# password via the Account panel.

# ---- Translator auth ----
# Peppers every translator password hash (in addition to its per-row salt).
# Never commit a real value; rotating it invalidates all translator passwords.
TRANSLATOR_PASSWORD_PEPPER=replace-with-random-translator-password-pepper
# Signs translator session cookies.
TRANSLATOR_SESSION_SECRET=replace-with-random-translator-session-secret

# ---- Volunteer auth ----
# Optional but strongly recommended in production. Signs volunteer session
# cookies; leaving it unset disables volunteer login (see env.ts).
VOLUNTEER_SESSION_SECRET=replace-with-random-volunteer-session-secret

# ---- Realtime / presence (optional) ----
# Enables the /smoke/realtime debug route on non-localhost hosts. Leave
# unset (or "false") in production; localhost always allows it regardless.
REALTIME_SMOKE_ENABLED=
# Overrides the live-listener count the public /status route reports.
# Leave unset to use the real LiveKit-derived presence count.
PRESENCE_LIVE_COUNT=

# ---- Database ----
# Path to the better-sqlite3 file. Leave this commented out -- both Docker
# Compose (docker-compose.yml defaults this to /data/bhasha.sqlite, matching
# the `bhasha_data` named volume) and local dev (apps/api/src/db/sqlite.ts
# defaults to ./data/bhasha.sqlite) already pick the right default for their
# environment. IMPORTANT: uncomment and set a value only to override those
# defaults, never to `DATABASE_PATH=` (empty) -- an empty string is not the
# same as unset and will be used as-is (better-sqlite3 opens an empty path
# as an anonymous temp DB). If you do override it for Compose, keep it
# inside the `bhasha_data` volume (i.e. under /data) or the DB won't survive
# `docker compose down`/container recreation.
# DATABASE_PATH=

# ---- LiveKit (server-side, apps/api/src/livekit/client.ts) ----
# Public wss:// URL for LiveKit's signaling endpoint -- used BOTH by the app
# server-side (RoomServiceClient/WebhookReceiver; the http(s) admin URL is
# derived from this by a scheme swap, see livekitHttpUrl()) AND handed to
# browser clients (livekit-client) as-is. In production this is the rtc.
# subdomain Caddy terminates TLS for (see the Caddyfile) -- e.g.
# wss://rtc.example.com. Must resolve publicly since browsers use it too.
LIVEKIT_URL=wss://rtc.example.com
# Shared with docker-compose.yml's `livekit` service (its `keys:` map and
# `webhook.api_key` are generated FROM these same two values -- see
# docker-compose.yml's comments) -- this is the one source of truth for the
# JWT trust relationship between the app and the LiveKit server.
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# ---- App server ----
# Directory the app serves the built SPA (and its index.html SPA fallback)
# from -- see apps/api/src/index.ts. Optional: docker-compose.yml already
# defaults this to /app/apps/web/dist, matching the Docker image's layout
# (see the Dockerfile) -- only set this to point at a different location.
WEB_DIST_PATH=/app/apps/web/dist
# Port the Node process listens on inside its container.
PORT=8787
# Host-side (loopback-only, 127.0.0.1) port docker-compose.yml publishes the
# app on directly, bypassing Caddy -- reachable from the VM itself (e.g. an
# SSH-tunneled debug session or a local health-check probe) but never from
# the public internet. Normally left equal to PORT above.
APP_PORT=8787

# ---- Caddy ----
# Public domain Caddy requests a Let's Encrypt cert for and proxies to the
# app. LiveKit gets its own subdomain automatically (rtc.<this value>, see
# the Caddyfile) -- point a second DNS A record at the same VM for it.
DOMAIN=example.com
