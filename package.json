{
    "name": "bhasha",
    "private": true,
    "workspaces": [
        "apps/api",
        "apps/web"
    ],
    "scripts": {
        "predev": "node -e \"const fs=require('fs');if(!fs.existsSync('.env'))fs.copyFileSync('.env.example','.env')\"",
        "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
        "dev:build": "docker compose -f docker-compose.yml -f docker-compose.dev.yml build",
        "dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
        "test": "npm test --workspaces",
        "typecheck": "npm run typecheck --workspaces",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:regression": "npm test --workspaces && npm run typecheck --workspaces && npm run e2e --workspace apps/web"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.12.0",
        "prettier": "^3.9.8",
        "typescript-eslint": "^8.70.1"
    }
}
